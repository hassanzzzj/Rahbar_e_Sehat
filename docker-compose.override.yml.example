# Example docker-compose override for local development
# Copy to docker-compose.override.yml and customize as needed
# DO NOT commit docker-compose.override.yml to version control

services:
  backend:
    ports:
      - "8000:8000"
    environment:
      - DEBUG=true
      - LOG_LEVEL=DEBUG

  frontend:
    ports:
      - "3000:3000"

  db:
    ports:
      - "5432:5432"
