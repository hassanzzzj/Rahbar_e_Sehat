# Rahbar-e-Sehat — Frontend Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.

# API base URL (backend)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Map tile provider URL (e.g. OpenStreetMap / custom)
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Map default center (lat,lng — Pakistan default)
VITE_MAP_DEFAULT_CENTER=33.6844,73.0479

# Map default zoom
VITE_MAP_DEFAULT_ZOOM=6

# Sentry / error-reporting DSN (optional)
VITE_SENTRY_DSN=

# Feature flags
VITE_ENABLE_VOICE_INPUT=true
VITE_ENABLE_URDU_UI=true
